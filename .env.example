# ===================================================================
# NutriCheck Environment Configuration Template (.env.example)
# ===================================================================
# Copy this file to .env or set these environment variables in your local shell / IDE.
# Do NOT commit your actual .env file or production credentials to source control.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nutricheck_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_local_db_password

# Initial Administrator Provisioning Configuration
# Required on initial startup to create the first system administrator account.
# If NUTRICHECK_ADMIN_PASSWORD is unset or blank, admin provisioning is safely skipped.
NUTRICHECK_ADMIN_USERNAME=admin
NUTRICHECK_ADMIN_EMAIL=admin@nutricheck.com
NUTRICHECK_ADMIN_PASSWORD=your_secure_admin_password_here
NUTRICHECK_ADMIN_FULL_NAME=System Administrator
NUTRICHECK_ADMIN_PHONE=+1 555-0199

# Security & Persistent Remember-Me
# Set a high-entropy random string for production. If unset, an ephemeral UUID is generated per runtime.
NUTRICHECK_REMEMBER_ME_KEY=your_random_remember_me_secret_key

# Demo & Clinical Seed Data (true for development, false for bare production)
NUTRICHECK_SEED_SAMPLE_DATA=true
